{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "external_directory": { "*": "allow" },
    "bash": {
      "*": "allow",
      "rm -rf *": "deny",
      "sudo *": "deny",
      "git push*": "deny",
      "git push* fix*": "allow",
      "git push*main*": "deny",
      "git push*master*": "deny"
    }
  }
}
