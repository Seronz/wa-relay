{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "external_directory": "allow",
    "bash": [
      {
        "pattern": "rm -rf *",
        "action": "deny"
      },
      {
        "pattern": "sudo *",
        "action": "deny"
      },
      {
        "pattern": "git push *",
        "action": "deny"
      },
      {
        "pattern": "*",
        "action": "allow"
      }
    ]
  }
}
